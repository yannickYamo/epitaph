# epitaph (ADR-005): the controller runs unprivileged and may block the creature
# cgroup's network, and nothing else, without a password. Installed by deploy/install.sh as
# /etc/sudoers.d/021_epitaph-netblock (mode 0440, checked with visudo -cf); @USER@ is the service
# user. The helper itself also rejects any other cgroup path.
@USER@ ALL=(root) NOPASSWD: /usr/local/sbin/epitaph-netblock status, /usr/local/sbin/epitaph-netblock ^(add|del) system[.]slice/epitaph[a-z0-9-]*[.]service/creature$
