# The backstop for the udev rule (deploy/sbin/epitaph-display-hotplug): every minute, in case a
# DRM change event was missed. A run with no connector change reads a few sysfs files and exits.
# Installed by deploy/install.sh into /etc/systemd/system; enabled with the other units.
[Unit]
Description=epitaph local display: look for a screen plugged in or out every minute
Documentation=https://github.com/yannickYamo/epitaph/blob/main/docs/INSTALLATION.md

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
